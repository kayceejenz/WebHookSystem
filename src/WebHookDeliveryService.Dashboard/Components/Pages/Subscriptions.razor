@page "/subscriptions"
@using WebHookDeliveryService.Application.DTOs
@inject HttpClient Http

<PageTitle>Subscriptions</PageTitle>

<h1>Webhook Subscriptions</h1>

@if (_subscriptions is null)
{
    <p>Loading...</p>
}
else
{
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #ddd; text-align: left;">
                <th style="padding: 8px;">Status</th>
                <th style="padding: 8px;">URL</th>
                <th style="padding: 8px;">Events</th>
                <th style="padding: 8px;">Max Retries</th>
                <th style="padding: 8px;">Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sub in _subscriptions)
            {
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 8px;">
                        <span style="color: @(sub.Active ? "#2e7d32" : "#c62828"); font-weight: bold;">
                            @(sub.Active ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td style="padding: 8px;">@sub.Url</td>
                    <td style="padding: 8px;">@string.Join(", ", sub.Events)</td>
                    <td style="padding: 8px;">@sub.MaxRetries</td>
                    <td style="padding: 8px;">@sub.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SubscriptionResponse>? _subscriptions;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _subscriptions = await Http.GetFromJsonAsync<List<SubscriptionResponse>>("/api/webhooks");
        }
        catch (Exception)
        {
            _subscriptions = [];
        }
    }
}
