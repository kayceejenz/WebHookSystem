@page "/"
@using WebHookDeliveryService.Application.DTOs
@inject HttpClient Http

<PageTitle>Webhook Dashboard</PageTitle>

<h1>Webhook Delivery Dashboard</h1>

@if (_stats is null)
{
    <p>Loading...</p>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
        <div style="background: #e8f5e9; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0; color: #2e7d32;">@_stats.SuccessfulDeliveries</h3>
            <p style="margin: 4px 0 0;">Successful</p>
        </div>
        <div style="background: #ffebee; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0; color: #c62828;">@_stats.FailedDeliveries</h3>
            <p style="margin: 4px 0 0;">Failed</p>
        </div>
        <div style="background: #fff3e0; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0; color: #e65100;">@_stats.RetryingDeliveries</h3>
            <p style="margin: 4px 0 0;">Retrying</p>
        </div>
        <div style="background: #fce4ec; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0; color: #ad1457;">@_stats.DeadLetteredCount</h3>
            <p style="margin: 4px 0 0;">Dead-Lettered</p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px;">
        <div style="background: #f5f5f5; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0;">@_stats.TotalSubscriptions</h3>
            <p style="margin: 4px 0 0;">Total Subscriptions</p>
        </div>
        <div style="background: #f5f5f5; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0;">@_stats.ActiveSubscriptions</h3>
            <p style="margin: 4px 0 0;">Active Subscriptions</p>
        </div>
        <div style="background: #f5f5f5; padding: 16px; border-radius: 8px;">
            <h3 style="margin: 0;">@($"{_stats.SuccessRate:F1}%")</h3>
            <p style="margin: 4px 0 0;">Success Rate (24h)</p>
        </div>
    </div>

    <h2>Recent Deliveries</h2>
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #ddd; text-align: left;">
                <th style="padding: 8px;">Status</th>
                <th style="padding: 8px;">Event Type</th>
                <th style="padding: 8px;">Target URL</th>
                <th style="padding: 8px;">Attempts</th>
                <th style="padding: 8px;">Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var delivery in _stats.RecentDeliveries)
            {
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 8px;">
                        <span style="color: @GetStatusColor(delivery.Status); font-weight: bold;">@delivery.Status</span>
                    </td>
                    <td style="padding: 8px;">@delivery.EventType</td>
                    <td style="padding: 8px;">@(delivery.SubscriptionUrl.Length > 40 ? delivery.SubscriptionUrl[..40] + "..." : delivery.SubscriptionUrl)</td>
                    <td style="padding: 8px;">@delivery.AttemptCount</td>
                    <td style="padding: 8px;">@delivery.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DashboardStatsResponse? _stats;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await Http.GetFromJsonAsync<DashboardStatsResponse>("/api/dashboard/stats");
        }
        catch (Exception)
        {
            _stats = new DashboardStatsResponse();
        }
    }

    private string GetStatusColor(DeliveryStatus status) => status switch
    {
        DeliveryStatus.Success => "#2e7d32",
        DeliveryStatus.Failed => "#c62828",
        DeliveryStatus.Retrying => "#e65100",
        DeliveryStatus.DeadLettered => "#ad1457",
        _ => "#666"
    };
}
